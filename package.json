{
  "name": "eclipse-rp",
  "version": "0.1.0",
  "private": true,
  "description": "ECLIPSE RP — GTA V RolePlay server on RAGE Multiplayer",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/cef"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build -w @eclipse/shared && npm run build -w @eclipse/server && npm run build -w @eclipse/client && npm run build -w @eclipse/cef",
    "build:server": "npm run build -w @eclipse/server",
    "build:client": "npm run build -w @eclipse/client",
    "build:cef": "npm run build -w @eclipse/cef",
    "dev:cef": "npm run dev -w @eclipse/cef",
    "typecheck": "tsc -b packages/shared packages/server packages/client",
    "migrate": "node scripts/migrate.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:schema": "node tools/schema-regression.mjs",
    "test:smoke": "node tools/smoke-server.mjs",
    "test:e2e": "node tools/e2e-flow.mjs",
    "verify": "npm run typecheck && npm run build && npm run test:schema && npm run test:e2e"
  },
  "devDependencies": { "esbuild": "^0.25.0", "typescript": "^5.7.2" }
}
