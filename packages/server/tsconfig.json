{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node",
      "@ragempcommunity/types-server"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
