# ---------- ECLIPSE RP — server configuration ----------
# Скопируйте в .env и заполните. .env НИКОГДА не коммитится.

NODE_ENV=development
ECLIPSE_SERVER_NAME=ECLIPSE RP

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eclipse_rp
DB_USER=eclipse
DB_PASSWORD=change_me
DB_POOL_MAX=10

# Redis (опционально; при отсутствии используется in-memory кэш)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Логирование: trace | debug | info | warn | error
LOG_LEVEL=debug

# Безопасность
# Количество попыток входа до временной блокировки
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
